<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="#F4F7F5">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="LABEL LENS / PROJECT 02" android:textSize="12sp" android:textStyle="bold"
            android:letterSpacing="0.12" android:textColor="#176859" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Read your label."
            android:textSize="32sp" android:textStyle="bold" android:textColor="#172E27"
            android:accessibilityHeading="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Hold the package steady in good light. Take a photo or choose one to read."
            android:textSize="17sp" android:textColor="#40594F" />
        <ImageView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="240dp"
            android:layout_marginTop="24dp" android:background="@drawable/panel"
            android:scaleType="fitCenter" android:contentDescription="Selected product label photo" />
        <Button android:id="@+id/camera" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:minHeight="56dp" android:text="Take a photo" />
        <Button android:id="@+id/import_photo" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="56dp" android:text="Choose a photo" />
        <CheckBox android:id="@+id/higher_contrast" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="Try higher contrast for label reading" android:textSize="16sp" />
        <Button android:id="@+id/scan" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="56dp" android:text="Read label" android:enabled="false" />
        <Button android:id="@+id/full_photo" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="56dp" android:text="Read full photo (comparison)" android:enabled="false" />
        <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="4dp"
            android:indeterminate="true" android:visibility="gone" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Choose a photo to begin."
            android:textSize="16sp" android:textColor="#40594F" android:accessibilityLiveRegion="polite" />
        <TextView android:id="@+id/crop_info" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:textSize="14sp" android:textColor="#40594F" android:visibility="gone" />
        <ImageView android:id="@+id/crop_preview" android:layout_width="match_parent" android:layout_height="160dp"
            android:layout_marginTop="8dp" android:background="@drawable/panel" android:scaleType="fitCenter"
            android:contentDescription="Exact label crop sent to text recognition" android:visibility="gone" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:orientation="vertical" android:background="@drawable/panel">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Recognized text" android:textSize="20sp" android:textStyle="bold"
                android:textColor="#172E27" android:accessibilityHeading="true" />
            <TextView android:id="@+id/result" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="Your label text will appear here."
                android:textIsSelectable="true" android:textSize="20sp" android:textColor="#172E27" />
            <Button android:id="@+id/speak" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:minHeight="56dp" android:text="Read aloud" android:enabled="false" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="Read label selects the strongest product-name detection. Use Read full photo to include text outside that region."
            android:textSize="14sp" android:textColor="#40594F" />
    </LinearLayout>
</ScrollView>
