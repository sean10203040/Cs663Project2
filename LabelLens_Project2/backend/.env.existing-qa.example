# Existing successful model inspected in your Cloud console on November 11.
GOOGLE_CLOUD_PROJECT=spatial-thinker-512218-b0
LABELLENS_QA_BASE_MODEL=gemini-3.5-flash
LABELLENS_QA_BASE_LOCATION=global
# The tuned endpoint is in us, not the tuning-job region us-central1.
LABELLENS_QA_TUNED_MODEL=projects/1056598944825/locations/us/endpoints/1423735616574586880
# Relative to the root where uvicorn is launched; Docker WORKDIR is /service.
LABELLENS_QA_PROMPT_FILE=backend/qa_prompt.json
# Generate locally; never use your Google access token as this value.
LABELLENS_APP_TOKEN=
